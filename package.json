{
  "name": "health-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "demo:seed": "tsx scripts/demo-reset.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "data:purge-expired": "tsx scripts/data-purge-expired-v1.ts",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "test": "vitest run --passWithNoTests --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:integration": "npm run prisma:generate && vitest run tests/integration",
    "test:e2e": "npm run prisma:generate && npm run db:migrate && npm run build && playwright test",
    "test:coverage": "npm run prisma:generate && vitest run --coverage --exclude 'tests/e2e/**'",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run prisma:generate && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.2.3",
    "next": "16.3.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prisma": "7.9.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
